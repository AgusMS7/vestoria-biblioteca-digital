# Google Drive
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_ROOT_FOLDER_ID=

# Branding (opcional; por defecto "Vestoria")
SITE_NAME=

# Basic Auth opcional (se activa solo si ambas están definidas)
SITE_AUTH_USER=
SITE_AUTH_PASS=

# Embed (opcional, default off): true quita X-Frame-Options y agrega
# Content-Security-Policy: frame-ancestors * (permite iframe). Se resuelve
# en build; setear en el proyecto demo de Vercel antes del deploy.
ALLOW_EMBED=
